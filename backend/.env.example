# ProspectAI Backend Environment Variables
PROJECT_NAME="ProspectAI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (Default: SQLite for zero-config demo, or PostgreSQL in production)
DATABASE_URL="sqlite:///./prospectai.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/prospectai_db"

# Security & JWT
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Models (Optional - Deterministic Smart Engine is active when omitted)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Integrations (Optional)
TELEGRAM_BOT_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
